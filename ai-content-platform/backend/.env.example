# ---- App ----
APP_NAME=AI Content Platform
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---- Google Gemini (LangChain) ----
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=1024

# ---- Content pipeline ----
CONTENT_MOCK=true
CONTENT_REFINEMENT_LOOP=true
CONTENT_REFINEMENT_MAX_ITERATIONS=2
CONTENT_QUALITY_THRESHOLD=0.7
CONTENT_PERSONALIZATION=true
CONTENT_SAFETY_FILTER=true
CONTENT_DEFAULT_TONE=professional
CONTENT_DEFAULT_LENGTH=medium
CONTENT_DEFAULT_PLATFORM=blog

# ---- Image generation ----
CONTENT_GENERATE_IMAGE=true
# pollinations (free, no key) or gemini (paid tier required)
IMAGE_PROVIDER=pollinations
IMAGE_POLLINATIONS_MODEL=flux
IMAGE_MODEL_ID=gemini-2.5-flash-image
IMAGE_WIDTH=1024
IMAGE_HEIGHT=576
IMAGE_STORAGE_DIR=./storage/images
PUBLIC_IMAGE_BASE_URL=/static/images

# ---- Storage ----
DATABASE_URL=sqlite:///./storage/content.db
